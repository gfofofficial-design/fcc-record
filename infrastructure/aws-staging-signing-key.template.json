{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "FCC staging-only Ed25519 receipt signing key. Deploy before the intake stack; no production resources.",
  "Parameters": {
    "OwnerTag": {
      "Type": "String",
      "Default": "GFOF-FCC",
      "AllowedPattern": "^[A-Za-z0-9._:/=+@-]{1,64}$",
      "Description": "Owner tag applied to the staging signing key."
    }
  },
  "Resources": {
    "ReceiptSigningKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "FCC staging-only Ed25519 provisional receipt signing key",
        "Enabled": true,
        "KeySpec": "ECC_NIST_EDWARDS25519",
        "KeyUsage": "SIGN_VERIFY",
        "MultiRegion": false,
        "Origin": "AWS_KMS",
        "PendingWindowInDays": 30,
        "BypassPolicyLockoutSafetyCheck": false,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "EnableAccountAdministrationAndIAMPolicies",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        },
        "Tags": [
          { "Key": "Project", "Value": "FCC" },
          { "Key": "Environment", "Value": "staging" },
          { "Key": "Owner", "Value": { "Ref": "OwnerTag" } },
          { "Key": "Production", "Value": "false" }
        ]
      }
    },
    "ReceiptSigningKeyAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": "alias/fcc-staging-intake-receipts",
        "TargetKeyId": { "Ref": "ReceiptSigningKey" }
      }
    }
  },
  "Outputs": {
    "SigningKeyArn": {
      "Description": "Immutable key ARN required by the intake stack. Do not pass the alias.",
      "Value": { "Fn::GetAtt": ["ReceiptSigningKey", "Arn"] }
    },
    "SigningKeyId": {
      "Description": "Key ID used to export and independently inspect the public key.",
      "Value": { "Fn::GetAtt": ["ReceiptSigningKey", "KeyId"] }
    },
    "SigningAlgorithm": {
      "Description": "Algorithm required by the staging intake implementation.",
      "Value": "ED25519_SHA_512"
    }
  }
}
