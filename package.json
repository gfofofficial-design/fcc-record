{
  "name": "fcc-record-tools",
  "version": "0.1.0",
  "private": true,
  "description": "FCC Stage-0 CI foundation tooling (Node primary)",
  "scripts": {
    "test:aws-quota": "node --test tests/aws-staging-quota.test.js",
    "check:aws-quota": "node tools/check-aws-staging-quota.js",
    "test:aws": "node --test tests/aws-staging-intake.test.js",
    "test:infra": "node --test tests/aws-staging-infrastructure.test.js",
    "test:aws-bundle": "python tests/aws-staging-bundle.test.py",
    "test:aws-preflight": "node --test tests/aws-staging-preflight.test.js",
    "build:aws-bundle": "python tools/build-aws-staging-bundle.py",
    "preflight:aws": "node tools/run-aws-staging-preflight.js",
    "test": "node tools/run-ci-foundation-tests.js",
    "test:app": "node --test tests/stage0-app.test.js",
    "verify:app": "node tools/verify-stage0.js",
    "verify:production": "node tools/verify-production-record.js",
    "test:production": "node --test tests/production-record.test.js",
    "build": "node tools/build-stage0.js",
    "start": "node tools/stage0-server.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1131.0",
    "@aws-sdk/client-kms": "3.1131.0",
    "@aws-sdk/client-sqs": "3.1131.0",
    "@aws-sdk/lib-dynamodb": "3.1131.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0"
  }
}
